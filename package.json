{
  "name": "learnbuild",
  "version": "0.1.0",
  "description": "Learning-first software development framework for Claude Code",
  "license": "MIT",
  "author": "Rhys",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RhyG/learnbuild.git"
  },
  "homepage": "https://github.com/RhyG/learnbuild#readme",
  "bugs": {
    "url": "https://github.com/RhyG/learnbuild/issues"
  },
  "keywords": [
    "claude-code",
    "learning",
    "education",
    "ai-coding",
    "cli"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "learnbuild": "dist/src/cli/main.js"
  },
  "files": [
    "dist/src",
    "templates",
    "standards",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.json && node -e \"require('node:fs').chmodSync('dist/src/cli/main.js', 0o755)\"",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
